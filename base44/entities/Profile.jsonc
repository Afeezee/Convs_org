{
  "name": "Profile",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email of the user - links to User entity"
    },
    "full_name": {
      "type": "string",
      "description": "Display name"
    },
    "username": {
      "type": "string",
      "description": "@handle"
    },
    "bio": {
      "type": "string"
    },
    "profile_image": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "followers_count": {
      "type": "number",
      "default": 0
    },
    "following_count": {
      "type": "number",
      "default": 0
    },
    "convs_count": {
      "type": "number",
      "default": 0
    },
    "support_count": {
      "type": "number",
      "default": 0
    },
    "oppose_count": {
      "type": "number",
      "default": 0
    },
    "avg_quality_score": {
      "type": "number",
      "default": 0
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "email",
    "full_name"
  ],
  "rls": {
    "create": {
      "data.email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}