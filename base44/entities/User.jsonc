{
  "name": "User",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "@handle"
    },
    "bio": {
      "type": "string"
    },
    "profile_image": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "followers_count": {
      "type": "number",
      "default": 0
    },
    "following_count": {
      "type": "number",
      "default": 0
    },
    "convs_count": {
      "type": "number",
      "default": 0
    },
    "support_count": {
      "type": "number",
      "default": 0
    },
    "oppose_count": {
      "type": "number",
      "default": 0
    },
    "avg_quality_score": {
      "type": "number",
      "default": 0
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "default": "light"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "moderator",
        "verified_expert"
      ]
    }
  },
  "required": [
    "username",
    "bio",
    "profile_image",
    "cover_image",
    "badges",
    "role"
  ]
}