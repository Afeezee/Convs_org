{
  "name": "Bookmark",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "conv_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "conv",
        "comment",
        "highlight"
      ],
      "default": "conv"
    },
    "comment_id": {
      "type": "string",
      "description": "If bookmarking a specific comment"
    },
    "note": {
      "type": "string",
      "description": "Optional personal note"
    }
  },
  "required": [
    "user_email",
    "conv_id"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}