{
  "name": "Reconv",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who reconved"
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the user who reconved"
    },
    "original_conv_id": {
      "type": "string",
      "description": "ID of the original conv being shared"
    },
    "original_author_email": {
      "type": "string"
    },
    "original_author_name": {
      "type": "string"
    },
    "thought": {
      "type": "string",
      "description": "Optional thought added by the user"
    }
  },
  "required": [
    "user_email",
    "user_name",
    "original_conv_id",
    "original_author_email",
    "original_author_name"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}