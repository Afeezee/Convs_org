{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Unique ID for the conversation thread"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "receiver_email": {
      "type": "string"
    },
    "receiver_name": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Message text"
    },
    "media_url": {
      "type": "string",
      "description": "Optional attached media"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "is_debate_invite": {
      "type": "boolean",
      "default": false
    },
    "invited_conv_id": {
      "type": "string",
      "description": "Conv ID if debate invite"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "pending",
        "blocked"
      ],
      "default": "sent",
      "description": "Message status - pending for non-followers"
    }
  },
  "required": [
    "sender_email",
    "receiver_email",
    "content",
    "conversation_id"
  ],
  "rls": {
    "create": {
      "data.sender_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.receiver_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.receiver_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.receiver_email": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.receiver_email": "{{user.email}}"
        }
      ]
    }
  }
}