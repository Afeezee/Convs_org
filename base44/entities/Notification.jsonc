{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Who receives this notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "follow",
        "comment",
        "support",
        "oppose",
        "mention",
        "flaw_tag",
        "highlight_reply"
      ],
      "description": "Notification type"
    },
    "from_email": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "conv_id": {
      "type": "string"
    },
    "comment_id": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_email",
    "type",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}